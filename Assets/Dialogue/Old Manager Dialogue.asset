  m_Script: {fileID: 11500000, guid: 09c5317b33ca1a348b364d39cdb12d89, type: 3}
  m_Name: Old Manager Dialogue
  m_EditorClassIdentifier: 
  speakerName: Old Manager
  sentences:
  - Hello there kind sir!
  - I am the manager of this fine establishment.
  - I am getting too old for this job now, and this establishment is getting quite
    run down.
  - The health inspector came by the other day, and he did not give us a good review.
  - I mean... just look at the rats roaming around.
